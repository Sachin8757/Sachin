<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/png" sizes="16x16" href="/images/logo.png">
    <title>Sachin Kumar</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

    body {
        background: #0d172e;
        color: #42409b;
        padding: 30px;
    }

        .container {
            max-width: 1200px;
            margin: auto;
        }

        /* Header */

        .header {
            text-align: center;
            margin-bottom: 35px;
        }

        .header h1 {
            font-size: 36px;
            margin-bottom: 10px;
        }

        .header p {
            color: #666;
            font-size: 16px;
        }

        /* Statistics */

        .stats {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: white;
            padding: 25px;
            border-radius: 12px;
            text-align: center;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.06);
        }

        .stat-card h2 {
            font-size: 32px;
            margin-bottom: 8px;
        }

        .stat-card p {
            color: #777;
            font-size: 15px;
        }

        /* Search */

        .search-section {
            margin-bottom: 30px;
        }

        .search-box {
            width: 100%;
            padding: 15px 18px;
            border: 1px solid #ddd;
            border-radius: 10px;
            font-size: 16px;
            outline: none;
            background: white;
        }

        .search-box:focus {
            border-color: #333;
        }

        /* Questions */

        .questions {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }

        .question-card {
            background: white;
            padding: 22px;
            border-radius: 12px;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.06);
            transition: 0.2s;
        }

        .question-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 18px rgba(0, 0, 0, 0.1);
        }

        .question-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }

        .leetcode-number {
            font-weight: bold;
            color: #555;
        }

        .difficulty {
            padding: 5px 10px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: bold;
        }

        .easy {
            background: #e7f8ed;
            color: #16803c;
        }

        .medium {
            background: #fff4dc;
            color: #a66b00;
        }

        .hard {
            background: #ffe5e5;
            color: #d32f2f;
        }

        .question-card h3 {
            font-size: 20px;
            margin-bottom: 10px;
        }

        .description {
            color: #666;
            line-height: 1.5;
            margin-bottom: 15px;

            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .topics {
            display: flex;
            flex-wrap: wrap;
            gap: 7px;
            margin-bottom: 18px;
        }

        .topic {
            background: #f0f0f0;
            padding: 5px 9px;
            border-radius: 5px;
            font-size: 12px;
            color: #555;
        }

        .view-btn {
            display: inline-block;
            text-decoration: none;
            background: #222;
            color: white;
            padding: 10px 18px;
            border-radius: 7px;
            font-size: 14px;
        }

        .view-btn:hover {
            background: #444;
        }

        .no-result {
            display: none;
            text-align: center;
            padding: 40px;
            color: #777;
            grid-column: 1 / -1;
        }

        /* Mobile */

        @media (max-width: 800px) {

            body {
                padding: 15px;
            }

            .stats {
                grid-template-columns: repeat(2, 1fr);
            }

            .questions {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 450px) {

            .stats {
                grid-template-columns: 1fr 1fr;
                gap: 10px;
            }

            .stat-card {
                padding: 18px 10px;
            }

            .stat-card h2 {
                font-size: 25px;
            }

            .header h1 {
                font-size: 28px;
            }
        }
  
        /* Questions Table */
        .questions-table-container {
            background: white;
            border-radius: 12px;
            overflow-x: auto;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.06);
        }

        .questions-table {
            width: 100%;
            border-collapse: collapse;
            min-width: 700px;
        }

        .questions-table th {
            background: #f8f9fa;
            color: #555;
            font-size: 14px;
            font-weight: 600;
            text-align: left;
            padding: 16px 18px;
            border-bottom: 1px solid #e5e5e5;
        }

        .questions-table td {
            padding: 16px 18px;
            border-bottom: 1px solid #eeeeee;
            font-size: 14px;
        }

        .questions-table tbody tr:hover {
            background: #fafafa;
        }

        .questions-table tbody tr:last-child td {
            border-bottom: none;
        }

        .problem-number {
            font-weight: 600;
            color: #555;
        }

        .problem-name {
            font-weight: 600;
            color: #222;
        }

        .difficulty {
            display: inline-block;
            padding: 5px 10px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }

        .easy {
            background: #e7f8ed;
            color: #16803c;
        }

        .medium {
            background: #fff4dc;
            color: #a66b00;
        }

        .hard {
            background: #ffe5e5;
            color: #d32f2f;
        }

        .topics {
            display: flex;
            flex-wrap: wrap;
            gap: 5px;
        }

        .topic {
            background: #f0f0f0;
            color: #555;
            padding: 4px 8px;
            border-radius: 5px;
            font-size: 11px;
        }

        .view-btn {
            display: inline-block;
            text-decoration: none;
            background: #222;
            color: white;
            padding: 8px 14px;
            border-radius: 6px;
            font-size: 13px;
        }

        .view-btn:hover {
            background: #444;
        }

        .no-result {
            display: none;
            text-align: center;
            padding: 40px;
            color: #777;
        }

        @media (max-width: 700px) {
            .questions-table {
                min-width: 650px;
            }
        }
    </style>
</head>

<body>

    <div class="container">

        <!-- Header -->

        <div class="header">

            <h1>DSA Problems</h1>

            <p>
                My LeetCode and Data Structures & Algorithms problem-solving journey
            </p>

        </div>


        <!-- Statistics -->

        <div class="stats">

            <div class="stat-card">
                <h2>
                    <%= total %>
                </h2>
                <p>Total Problems</p>
            </div>

            <div class="stat-card">
                <h2>
                    <%= easy %>
                </h2>
                <p>Easy</p>
            </div>

            <div class="stat-card">
                <h2>
                    <%= medium %>
                </h2>
                <p>Medium</p>
            </div>

            <div class="stat-card">
                <h2>
                    <%= hard %>
                </h2>
                <p>Hard</p>
            </div>

        </div>


        <!-- Search -->

        <div class="search-section">

            <input type="text" id="searchInput" class="search-box"
                placeholder="Search by question name or LeetCode number...">

        </div>


        <!-- Questions -->

        <div class="questions-table-container">
            <table class="questions-table">
                <thead>
                    <tr>
                        <th> # </th>
                        <th> Problem </th>
                        <th> Difficulty </th>
                        <th> Topics </th>
                        <th> Action </th>
                    </tr>
                </thead>
                <tbody id="questionList">
                    <% questions.forEach(question=> { %> <tr class="question-row"
                            data-title="<%= question.title.toLowerCase() %>"
                            data-number="<%= question.leetcodeNumber %>">
                            <td> <span class="problem-number"> #<%= question.leetcodeNumber %> </span> </td>
                            <td> <span class="problem-name">
                                    <%= question.title %>
                                </span> </td>
                            <td> <span class="difficulty <%= question.difficulty.toLowerCase() %>">
                                    <%= question.difficulty %>
                                </span> </td>
                            <td>
                                <div class="topics">
                                    <% if (question.topics && question.topics.length> 0) { %> <%
                                            question.topics.forEach(topic=> { %> <span class="topic">
                                                <%= topic %>
                                            </span>
                                            <% }) %>
                                                <% } else { %> <span class="topic"> DSA </span>
                                                    <% } %>
                                </div>
                            </td>
                            <td> <a href="/dsa/<%= question._id %>" class="view-btn"> View </a> </td>
                        </tr>
                        <% }) %>
                </tbody>
            </table>
            <div class="no-result" id="noResult"> No DSA problem found. </div>
        </div>

    </div>


    <script> const searchInput = document.getElementById("searchInput"); const rows = document.querySelectorAll(".question-row"); const noResult = document.getElementById("noResult"); searchInput.addEventListener("input", function () { const searchValue = this.value.toLowerCase().trim(); let found = 0; rows.forEach(row => { const title = row.dataset.title; const number = row.dataset.number; if (title.includes(searchValue) || number.includes(searchValue)) { row.style.display = "table-row"; found++; } else { row.style.display = "none"; } }); if (found === 0) { noResult.style.display = "block"; } else { noResult.style.display = "none"; } }); </script>

</body>

</html>